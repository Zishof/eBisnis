# Konfigurasi produksi eBisnis.id.
#
# Salin ke /etc/ebisnis/ebisnis.env, isi nilainya, lalu kunci izinnya:
#     sudo install -d -o root -g ebisnis -m 750 /etc/ebisnis
#     sudo cp deploy/env.production.example /etc/ebisnis/ebisnis.env
#     sudo chown root:ebisnis /etc/ebisnis/ebisnis.env
#     sudo chmod 640 /etc/ebisnis/ebisnis.env
#
# Direktori WAJIB 750 dengan grup ebisnis. Tanpa izin telusur pada direktori,
# pengguna aplikasi tidak dapat membuka berkas ini walau berkasnya 640.
#
# Berkas ini TIDAK PERNAH masuk repository. Yang di-commit hanya contoh ini,
# dan contoh tidak boleh memuat satu pun nilai sungguhan.

NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------------------
# Database
#
# Ketiganya menunjuk database yang sama.
#   DATABASE_URL         koneksi aplikasi, search_path pada schema platform
#   DIRECT_DATABASE_URL  dipakai Prisma Migrate, tanpa pooler
#   DATABASE_ADMIN_URL   tanpa parameter schema; dipakai untuk MEMBUAT schema
#                        tenant, sehingga penggunanya perlu hak CREATE
#
# Bila kata sandi memuat karakter khusus (@ : / ? # & %), tuliskan
# ter-URL-encode. Contoh: p@ss:w/rd  ->  p%40ss%3Aw%2Frd
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5434/ebisnis?schema=platform
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5434/ebisnis?schema=platform
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@HOST:5434/ebisnis

# ---------------------------------------------------------------------------
# JWT — WAJIB diganti. Minimal 32 karakter, acak, berbeda satu sama lain.
# Hasilkan dengan:  openssl rand -base64 48
#
# Mengganti nilai ini mencabut seluruh sesi yang sedang berjalan.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Alamat publik
#
# Frontend dan API berada pada origin yang sama karena Apache mem-proxy /api,
# sehingga CORS praktis tidak terpakai browser. Tetap diisi benar agar
# permintaan dari luar origin ditolak.
# ---------------------------------------------------------------------------
# Kelima portal. Origin yang tidak terdaftar di sini akan ditolak peramban
# saat memanggil API — dan gejalanya hanyalah halaman yang tidak memuat data,
# tanpa galat yang menyebut CORS di layar pengguna.
CORS_ORIGINS=https://ebisnis.id,https://www.ebisnis.id,https://app.ebisnis.id,https://enterprise-education.id,https://www.enterprise-education.id,https://app.enterprise-education.id,https://emedik.id,https://www.emedik.id,https://app.emedik.id,https://ekoperasi.id,https://www.ekoperasi.id,https://app.ekoperasi.id,https://info-desa.id,https://www.info-desa.id,https://app.info-desa.id
APP_URL=https://ebisnis.id
WEB_URL=https://ebisnis.id
APP_NAME=eBisnis.id
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Schema
# ---------------------------------------------------------------------------
PLATFORM_SCHEMA=platform
PLATFORM_AUDIT_SCHEMA=platform__audit
DEMO_SCHEMA=demo
DEMO_AUDIT_SCHEMA=demo__audit
TENANT_SCHEMA_SUFFIX_AUDIT=__audit
TENANT_SCHEMA_BASE_MAX_LENGTH=48
TENANT_CLIENT_CACHE_MAX=50
TENANT_CLIENT_IDLE_TTL_SECONDS=900

# Reset sandbox demo berkala. Aktifkan hanya bila demo publik dibuka.
DEMO_RESET_CRON=0 */6 * * *
DEMO_RESET_ENABLED=false

# ---------------------------------------------------------------------------
# Rate limit per menit per alamat IP.
#
# Apache mem-proxy seluruh trafik, jadi tanpa penanganan X-Forwarded-For
# aplikasi melihat satu alamat IP saja. Jangan menaikkan nilai ini untuk
# mengatasinya — perbaiki pembacaan IP asal.
# ---------------------------------------------------------------------------
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
DEMO_SESSION_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Super admin awal.
#
# Dibuat oleh `pnpm seed:platform` saat instalasi. Kata sandi WAJIB diganti pada
# login pertama, dan seed berikutnya tidak akan mengembalikannya ke nilai ini.
# Setelah instalasi berhasil, kosongkan kembali nilai kata sandinya.
# ---------------------------------------------------------------------------
BOOTSTRAP_SUPER_ADMIN_USERNAME=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FORCE_PASSWORD_CHANGE=true

DEFAULT_LOCALE=id
SUPPORTED_LOCALES=id,en,ar,zh-CN

DEFAULT_POS_MONTHLY_PRICE_IDR=250000
DEFAULT_POS_TRIAL_DAYS=30

# ---------------------------------------------------------------------------
# Esmartlink. Biarkan nonaktif sampai kredensial sandbox tersedia dan diuji.
# ---------------------------------------------------------------------------
ESMARTLINK_ENABLED=false
ESMARTLINK_BASE_URL=
ESMARTLINK_MERCHANT_ID=
ESMARTLINK_CLIENT_ID=
ESMARTLINK_CLIENT_SECRET=
ESMARTLINK_CALLBACK_URL=https://ebisnis.id/api/v1/payments/esmartlink/callback
ESMARTLINK_ALLOWED_IPS=
ESMARTLINK_TRUST_PROXY=true
ESMARTLINK_CALLBACK_ACK_SUCCESS=OK
ESMARTLINK_CALLBACK_ACK_ERROR=ERROR
ESMARTLINK_RAW_PAYLOAD_RETENTION_DAYS=90
ESMARTLINK_CHECK_BATCH_MAX=300
ESMARTLINK_CHECK_CONCURRENCY=4

# --- Enkripsi credential provider pembayaran (Versi 9) ----------------------
# WAJIB diisi sebelum fitur marketplace dipakai. Tanpa ini, penyimpanan
# credential eSmartlink milik tenant akan ditolak.
#
# Hasilkan kunci dengan:  openssl rand -base64 48
# Format: id:bahan  — id bebas tetapi harus stabil; bahan minimal 32 karakter.
#
# ROTASI: tambahkan kunci baru di depan koma, pindahkan ACTIVE_KEY ke id baru,
# dan JANGAN menghapus kunci lama sampai seluruh credential dirotasi. Kunci lama
# yang terhapus membuat credential yang memakainya tidak dapat dibuka lagi.
CREDENTIAL_ENCRYPTION_KEYS=prod1:GANTI_DENGAN_HASIL_OPENSSL_RAND
CREDENTIAL_ENCRYPTION_ACTIVE_KEY=prod1

# ---------------------------------------------------------------------------
# AI (Versi 11)
#
# HANYA backend yang memakai alamat ini. Peramban tidak pernah memanggil
# penyedia AI langsung, sehingga alamat ini tidak boleh diberi awalan VITE_
# maupun disalin ke konfigurasi web.
#
# Bila dikosongkan, seluruh endpoint AI tetap hidup tetapi melaporkan penyedia
# DOWN — bukan gagal diam-diam.
# ---------------------------------------------------------------------------
AI_PROVIDER=ollama
OLLAMA_URL=http://38.47.182.162:11434

# Nama model sengaja TIDAK disetel di sini. Katalog diisi dengan bertanya
# kepada penyedianya lewat POST /platform/ai/models/sync, lalu kemampuannya
# diuji lewat POST /platform/ai/models/probe.
