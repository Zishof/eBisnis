{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    // Disimpan di dalam dist agar `deleteOutDir` juga membuang cache incremental.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
