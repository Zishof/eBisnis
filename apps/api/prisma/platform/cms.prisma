// ---------------------------------------------------------------------------
// CMS — website publik eBisnis.id yang dapat diubah tanpa mengubah source
// ---------------------------------------------------------------------------

model Website {
  id                String  @id @default(uuid()) @db.Uuid
  /// Pemilik situs. NULL berarti milik platform sendiri — sebagaimana seluruh
  /// baris yang ada sebelum kolom ini ditambahkan (EP-C).
  ///
  /// Mesin CMS ini semula melayani banyak SITUS, bukan banyak PENYEWA. Tanpa
  /// kolom ini, endpoint publik CMS tidak dapat membedakan situs platform dari
  /// situs pondok — penghalang tepat bagi janji "berita disunting pondok
  /// sendiri" pada halaman pemasaran santri.info.
  tenantId          String? @map("tenant_id") @db.Uuid
  code              String  @db.VarChar(48)
  name              String  @db.VarChar(160)
  primaryDomain     String  @map("primary_domain") @db.VarChar(255)
  defaultLocaleCode String  @default("id") @map("default_locale_code") @db.VarChar(16)
  themeCode         String  @default("default") @map("theme_code") @db.VarChar(48)
  logoAssetId       String? @map("logo_asset_id") @db.Uuid
  faviconAssetId    String? @map("favicon_asset_id") @db.Uuid
  sortOrder         Int     @default(0) @map("sort_order")

  isActive      Boolean   @default(true) @map("is_active")
  isSystem      Boolean   @default(true) @map("is_system")
  isSample      Boolean   @default(false) @map("is_sample")
  sampleBatchId String?   @map("sample_batch_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteReason  String?   @map("delete_reason") @db.Text
  version       Int       @default(1)

  tenant         Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domains        WebsiteDomain[]
  pages          CmsPage[]
  navigations    CmsNavigation[]
  footerSections CmsFooterSection[]
  heroSlides     HeroSlide[]
  redirects      RedirectRule[]
  pricingSections PricingDisplaySection[]
  newsCategories NewsCategory[]
  newsArticles   NewsArticle[]

  @@unique([code])
  @@index([isActive, deletedAt])
  @@index([isSample, sampleBatchId])
  @@index([tenantId])
  @@map("website")
  @@schema("platform")
}

model WebsiteDomain {
  id                String  @id @default(uuid()) @db.Uuid
  websiteId         String  @map("website_id") @db.Uuid
  domain            String  @db.VarChar(255)
  isPrimary         Boolean @default(false) @map("is_primary")
  sslRequired       Boolean @default(true) @map("ssl_required")
  redirectToPrimary Boolean @default(false) @map("redirect_to_primary")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([domain])
  @@index([websiteId, isPrimary])
  @@map("website_domain")
  @@schema("platform")
}

model CmsPage {
  id                 String      @id @default(uuid()) @db.Uuid
  websiteId          String      @map("website_id") @db.Uuid
  parentId           String?     @map("parent_id") @db.Uuid
  slug               String      @db.VarChar(160)
  code               String      @db.VarChar(64)
  pageType           CmsPageType @default(STANDARD) @map("page_type")
  templateCode       String      @default("default") @map("template_code") @db.VarChar(48)
  status             CmsStatus   @default(DRAFT)
  publishedVersionId String?     @map("published_version_id") @db.Uuid
  showInNavigation   Boolean     @default(false) @map("show_in_navigation")
  sortOrder          Int         @default(0) @map("sort_order")

  isActive      Boolean   @default(true) @map("is_active")
  isSystem      Boolean   @default(false) @map("is_system")
  isSample      Boolean   @default(false) @map("is_sample")
  sampleBatchId String?   @map("sample_batch_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteReason  String?   @map("delete_reason") @db.Text
  version       Int       @default(1)

  website        Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  parent         CmsPage?             @relation("PageTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       CmsPage[]            @relation("PageTree")
  versions       CmsPageVersion[]
  navigationItems CmsNavigationItem[]
  structuredData SeoStructuredData[]

  @@unique([websiteId, slug])
  @@unique([websiteId, code])
  @@index([status, isActive, deletedAt])
  @@index([parentId, sortOrder])
  @@index([isSample, sampleBatchId])
  @@map("cms_page")
  @@schema("platform")
}

model CmsPageVersion {
  id            String    @id @default(uuid()) @db.Uuid
  pageId        String    @map("page_id") @db.Uuid
  versionNumber Int       @map("version_number")
  title         String    @db.VarChar(255)
  summary       String?   @db.Text
  seoTitle      String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?  @map("seo_description") @db.Text
  seoKeywords   String?   @map("seo_keywords") @db.VarChar(500)
  ogImageAssetId String?  @map("og_image_asset_id") @db.Uuid
  status        CmsStatus @default(DRAFT)
  scheduledAt   DateTime? @map("scheduled_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  publishedBy   String?   @map("published_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  version       Int       @default(1)

  page         CmsPage              @relation(fields: [pageId], references: [id], onDelete: Cascade)
  translations CmsPageTranslation[]
  blocks       CmsBlock[]

  @@unique([pageId, versionNumber])
  @@index([status, scheduledAt])
  @@map("cms_page_version")
  @@schema("platform")
}

model CmsPageTranslation {
  id             String   @id @default(uuid()) @db.Uuid
  pageVersionId  String   @map("page_version_id") @db.Uuid
  localeCode     String   @map("locale_code") @db.VarChar(16)
  title          String   @db.VarChar(255)
  summary        String?  @db.Text
  seoTitle       String?  @map("seo_title") @db.VarChar(255)
  seoDescription String?  @map("seo_description") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)

  pageVersion CmsPageVersion @relation(fields: [pageVersionId], references: [id], onDelete: Cascade)
  locale      Locale         @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([pageVersionId, localeCode])
  @@index([localeCode])
  @@map("cms_page_translation")
  @@schema("platform")
}

model CmsBlock {
  id            String  @id @default(uuid()) @db.Uuid
  pageVersionId String  @map("page_version_id") @db.Uuid
  parentBlockId String? @map("parent_block_id") @db.Uuid
  blockType     String  @map("block_type") @db.VarChar(48)
  blockKey      String  @map("block_key") @db.VarChar(64)
  layout        String  @default("default") @db.VarChar(48)
  settings      Json?
  sortOrder     Int     @default(0) @map("sort_order")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  pageVersion  CmsPageVersion        @relation(fields: [pageVersionId], references: [id], onDelete: Cascade)
  parent       CmsBlock?             @relation("BlockTree", fields: [parentBlockId], references: [id], onDelete: Cascade)
  children     CmsBlock[]            @relation("BlockTree")
  translations CmsBlockTranslation[]

  @@unique([pageVersionId, blockKey])
  @@index([pageVersionId, sortOrder])
  @@index([parentBlockId])
  @@map("cms_block")
  @@schema("platform")
}

model CmsBlockTranslation {
  id          String   @id @default(uuid()) @db.Uuid
  blockId     String   @map("block_id") @db.Uuid
  localeCode  String   @map("locale_code") @db.VarChar(16)
  eyebrow     String?  @db.VarChar(255)
  heading     String?  @db.VarChar(500)
  subheading  String?  @db.Text
  body        String?  @db.Text
  buttonLabel String?  @map("button_label") @db.VarChar(160)
  buttonUrl   String?  @map("button_url") @db.VarChar(500)
  contentJson Json?    @map("content_json")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  block  CmsBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  locale Locale   @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([blockId, localeCode])
  @@index([localeCode])
  @@map("cms_block_translation")
  @@schema("platform")
}

model CmsNavigation {
  id        String                @id @default(uuid()) @db.Uuid
  websiteId String                @map("website_id") @db.Uuid
  code      String                @db.VarChar(48)
  name      String                @db.VarChar(120)
  location  CmsNavigationLocation @default(HEADER)
  sortOrder Int                   @default(0) @map("sort_order")

  isActive  Boolean   @default(true) @map("is_active")
  isSystem  Boolean   @default(false) @map("is_system")
  isSample  Boolean   @default(false) @map("is_sample")
  sampleBatchId String? @map("sample_batch_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  website Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  items   CmsNavigationItem[]

  @@unique([websiteId, code])
  @@index([location, isActive])
  @@map("cms_navigation")
  @@schema("platform")
}

model CmsNavigationItem {
  id           String  @id @default(uuid()) @db.Uuid
  navigationId String  @map("navigation_id") @db.Uuid
  parentId     String? @map("parent_id") @db.Uuid
  labelKey     String  @map("label_key") @db.VarChar(160)
  defaultLabel String  @map("default_label") @db.VarChar(160)
  pageId       String? @map("page_id") @db.Uuid
  externalUrl  String? @map("external_url") @db.VarChar(500)
  anchor       String? @db.VarChar(96)
  icon         String? @db.VarChar(64)
  target       String  @default("_self") @db.VarChar(16)
  sortOrder    Int     @default(0) @map("sort_order")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  navigation CmsNavigation       @relation(fields: [navigationId], references: [id], onDelete: Cascade)
  parent     CmsNavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   CmsNavigationItem[] @relation("NavTree")
  page       CmsPage?            @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([navigationId, sortOrder])
  @@index([parentId])
  @@map("cms_navigation_item")
  @@schema("platform")
}

model CmsFooterSection {
  id        String @id @default(uuid()) @db.Uuid
  websiteId String @map("website_id") @db.Uuid
  code      String @db.VarChar(48)
  titleKey  String @map("title_key") @db.VarChar(160)
  defaultTitle String @map("default_title") @db.VarChar(160)
  sortOrder Int    @default(0) @map("sort_order")

  isActive  Boolean   @default(true) @map("is_active")
  isSample  Boolean   @default(false) @map("is_sample")
  sampleBatchId String? @map("sample_batch_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  website Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  items   CmsFooterItem[]

  @@unique([websiteId, code])
  @@index([sortOrder])
  @@map("cms_footer_section")
  @@schema("platform")
}

model CmsFooterItem {
  id              String  @id @default(uuid()) @db.Uuid
  footerSectionId String  @map("footer_section_id") @db.Uuid
  labelKey        String  @map("label_key") @db.VarChar(160)
  defaultLabel    String  @map("default_label") @db.VarChar(160)
  url             String  @db.VarChar(500)
  icon            String? @db.VarChar(64)
  sortOrder       Int     @default(0) @map("sort_order")

  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  version   Int       @default(1)

  section CmsFooterSection @relation(fields: [footerSectionId], references: [id], onDelete: Cascade)

  @@index([footerSectionId, sortOrder])
  @@map("cms_footer_item")
  @@schema("platform")
}

model NewsCategory {
  id           String  @id @default(uuid()) @db.Uuid
  /// Situs pemilik kategori ini (EP-C2). Sebelum kolom ini, `slug` unik secara
  /// GLOBAL lintas seluruh situs — begitu situs pondok kedua memilih slug yang
  /// sama dengan pondok pertama atau dengan platform eBisnis.id sendiri,
  /// pembuatannya gagal tanpa alasan yang masuk akal bagi penggunanya. Kolom
  /// ini wajib diisi (bukan nullable seperti `Website.tenantId`) sebab setiap
  /// kategori SELALU milik satu situs tertentu — tidak ada kategori "tanpa
  /// situs" sebagaimana ada `Website` "tanpa penyewa" (milik platform).
  websiteId    String  @map("website_id") @db.Uuid
  parentId     String? @map("parent_id") @db.Uuid
  code         String  @db.VarChar(48)
  nameKey      String  @map("name_key") @db.VarChar(160)
  defaultName  String  @map("default_name") @db.VarChar(160)
  slug         String  @db.VarChar(96)
  description  String? @db.Text
  sortOrder    Int     @default(0) @map("sort_order")

  isActive      Boolean   @default(true) @map("is_active")
  isSystem      Boolean   @default(false) @map("is_system")
  isSample      Boolean   @default(false) @map("is_sample")
  sampleBatchId String?   @map("sample_batch_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteReason  String?   @map("delete_reason") @db.Text
  version       Int       @default(1)

  website  Website        @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  parent   NewsCategory?  @relation("NewsCatTree", fields: [parentId], references: [id], onDelete: Restrict)
  children NewsCategory[] @relation("NewsCatTree")
  articles NewsArticle[]

  @@unique([code])
  @@unique([websiteId, slug])
  @@index([isActive, deletedAt])
  @@index([isSample, sampleBatchId])
  @@index([websiteId])
  @@map("news_category")
  @@schema("platform")
}

model NewsArticle {
  id              String    @id @default(uuid()) @db.Uuid
  /// Situs pemilik artikel ini (EP-C2). Lihat catatan pada `NewsCategory.websiteId`
  /// — sengaja NOT NULL, sebab artikel tanpa situs tidak dapat ditampilkan
  /// (dan tidak pernah dimaksudkan) di mana pun.
  websiteId       String    @map("website_id") @db.Uuid
  categoryId      String    @map("category_id") @db.Uuid
  authorUserId    String?   @map("author_user_id") @db.Uuid
  slug            String    @db.VarChar(160)
  code            String    @db.VarChar(64)
  status          CmsStatus @default(DRAFT)
  featuredImageId String?   @map("featured_image_id") @db.Uuid
  publishedAt     DateTime? @map("published_at") @db.Timestamptz(6)
  expiredAt       DateTime? @map("expired_at") @db.Timestamptz(6)
  isFeatured      Boolean   @default(false) @map("is_featured")
  isPinned        Boolean   @default(false) @map("is_pinned")
  viewCount       Int       @default(0) @map("view_count")
  publishedVersionId String? @map("published_version_id") @db.Uuid
  sortOrder       Int       @default(0) @map("sort_order")

  isActive      Boolean   @default(true) @map("is_active")
  isSystem      Boolean   @default(false) @map("is_system")
  isSample      Boolean   @default(false) @map("is_sample")
  sampleBatchId String?   @map("sample_batch_id") @db.Uuid
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy     String?   @map("updated_by") @db.Uuid
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)
  deactivatedBy String?   @map("deactivated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy     String?   @map("deleted_by") @db.Uuid
  deleteReason  String?   @map("delete_reason") @db.Text
  version       Int       @default(1)

  website       Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  category      NewsCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author        PlatformUser?        @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  featuredImage MediaAsset?          @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  versions      NewsArticleVersion[]
  tags          NewsArticleTag[]

  @@unique([websiteId, slug])
  @@unique([code])
  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([isActive, deletedAt])
  @@index([isSample, sampleBatchId])
  @@index([websiteId])
  @@map("news_article")
  @@schema("platform")
}

model NewsArticleVersion {
  id            String    @id @default(uuid()) @db.Uuid
  articleId     String    @map("article_id") @db.Uuid
  versionNumber Int       @map("version_number")
  title         String    @db.VarChar(255)
  summary       String?   @db.Text
  content       String    @db.Text
  status        CmsStatus @default(DRAFT)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  version       Int       @default(1)

  article      NewsArticle              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  translations NewsArticleTranslation[]

  @@unique([articleId, versionNumber])
  @@index([status])
  @@map("news_article_version")
  @@schema("platform")
}

model NewsArticleTranslation {
  id                   String   @id @default(uuid()) @db.Uuid
  articleVersionId     String   @map("article_version_id") @db.Uuid
  localeCode           String   @map("locale_code") @db.VarChar(16)
  title                String   @db.VarChar(255)
  summary              String?  @db.Text
  content              String   @db.Text
  seoTitle             String?  @map("seo_title") @db.VarChar(255)
  seoDescription       String?  @map("seo_description") @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int      @default(1)

  articleVersion NewsArticleVersion @relation(fields: [articleVersionId], references: [id], onDelete: Cascade)
  locale         Locale             @relation(fields: [localeCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@unique([articleVersionId, localeCode])
  @@index([localeCode])
  @@map("news_article_translation")
  @@schema("platform")
}

model NewsTag {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @db.VarChar(48)
  nameKey     String  @map("name_key") @db.VarChar(160)
  defaultName String  @map("default_name") @db.VarChar(160)
  slug        String  @db.VarChar(96)
  sortOrder   Int     @default(0) @map("sort_order")

  isActive      Boolean   @default(true) @map("is_active")
  isSample      Boolean   @default(false) @map("is_sample")
  sampleBatchId String?   @map("sample_batch_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)
  deleteReason  String?   @map("delete_reason") @db.Text
  version       Int       @default(1)

  articles NewsArticleTag[]

  @@unique([code])
  @@unique([slug])
  @@index([isActive, deletedAt])
  @@index([isSample, sampleBatchId])
  @@map("news_tag")
  @@schema("platform")
}

model NewsArticleTag {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

