{
  "name": "@ebisnis/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node -P tsconfig.json prisma/seed.ts",
    "seed:platform": "ts-node -P tsconfig.json src/cli/seed-platform.cli.ts",
    "seed:tenant": "ts-node -P tsconfig.json src/cli/seed-tenant.cli.ts",
    "seed:verify": "ts-node -P tsconfig.json src/cli/seed-verify.cli.ts",
    "seed:repair": "ts-node -P tsconfig.json src/cli/seed-repair.cli.ts",
    "seed:cleanup": "ts-node -P tsconfig.json src/cli/seed-cleanup.cli.ts",
    "docs:generate": "ts-node -P tsconfig.json src/cli/generate-docs.cli.ts",
    "migrate:tenants": "ts-node -P tsconfig.json src/cli/migrate-tenants.cli.ts",
    "route:audit": "ts-node -P tsconfig.json src/cli/route-audit.cli.ts",
    "seed:catalog": "ts-node -P tsconfig.json src/cli/seed-catalog.cli.ts",
    "seed:marketplace-demo": "ts-node -P tsconfig.json src/cli/seed-marketplace-demo.cli.ts",
    "sample:list": "ts-node -P tsconfig.json src/cli/sample-catalog.cli.ts list",
    "sample:hide": "ts-node -P tsconfig.json src/cli/sample-catalog.cli.ts hide",
    "sample:show": "ts-node -P tsconfig.json src/cli/sample-catalog.cli.ts show"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "nanoid": "^3.3.8",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
