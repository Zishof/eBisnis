NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL 12+ diperlukan. Pada mesin development referensi, PostgreSQL 17
# berjalan di port 5433 karena 5432 ditempati instance legacy 9.3.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ebisnis?schema=platform
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/ebisnis?schema=platform
DATABASE_ADMIN_URL=postgresql://USER:PASSWORD@localhost:5433/ebisnis

JWT_ACCESS_SECRET=change-this-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug
APP_NAME=eBisnis.id
APP_URL=http://localhost:3000
WEB_URL=http://localhost:5173

PLATFORM_SCHEMA=platform
PLATFORM_AUDIT_SCHEMA=platform__audit
DEMO_SCHEMA=demo
DEMO_AUDIT_SCHEMA=demo__audit
TENANT_SCHEMA_SUFFIX_AUDIT=__audit
TENANT_SCHEMA_BASE_MAX_LENGTH=48
TENANT_CLIENT_CACHE_MAX=50
TENANT_CLIENT_IDLE_TTL_SECONDS=900
DEMO_RESET_CRON=0 */6 * * *
DEMO_RESET_ENABLED=false

# Batas rate global per menit per alamat IP. Nilai bawaan aman untuk produksi.
# Naikkan hanya pada environment pengembangan/pengujian otomatis.
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10
DEMO_SESSION_RATE_LIMIT=20

# Production WAJIB mengambil nilai ini dari secret manager.
BOOTSTRAP_SUPER_ADMIN_USERNAME=admin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FORCE_PASSWORD_CHANGE=true

DEFAULT_LOCALE=id
SUPPORTED_LOCALES=id,en,ar,zh-CN

DEFAULT_POS_MONTHLY_PRICE_IDR=250000
DEFAULT_POS_TRIAL_DAYS=30

ESMARTLINK_ENABLED=false
ESMARTLINK_BASE_URL=
ESMARTLINK_MERCHANT_ID=
ESMARTLINK_CLIENT_ID=
ESMARTLINK_CLIENT_SECRET=
ESMARTLINK_CALLBACK_URL=http://localhost:3000/api/v1/payments/esmartlink/callback
ESMARTLINK_ALLOWED_IPS=
ESMARTLINK_TRUST_PROXY=false
ESMARTLINK_CALLBACK_ACK_SUCCESS=OK
ESMARTLINK_CALLBACK_ACK_ERROR=ERROR
ESMARTLINK_RAW_PAYLOAD_RETENTION_DAYS=90
ESMARTLINK_CHECK_BATCH_MAX=300
ESMARTLINK_CHECK_CONCURRENCY=4

# --- Enkripsi credential provider pembayaran (Versi 9) ----------------------
# Dipakai menyimpan credential eSmartlink milik masing-masing tenant.
# Kunci berasal dari environment, tidak pernah dari basis data.
#
# Format: id:bahan,id2:bahan2  — bahan minimal 32 karakter.
# Hasilkan dengan: openssl rand -base64 48
#
# Saat rotasi, kunci lama TETAP dipasang agar credential yang disandikan
# dengannya masih dapat dibuka. Hapus kunci lama hanya setelah seluruh
# credential dirotasi.
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_ACTIVE_KEY=
