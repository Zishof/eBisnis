<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Village Mobile</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>village_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!--
		Alasannya ditulis untuk dibaca warga, bukan untuk memenuhi syarat App
		Store. Kalimat "aplikasi ini membutuhkan akses kamera" tidak menjelaskan
		apa pun kepada orang yang sedang memutuskan menekan Izinkan atau tidak.

		Tidak ada NSLocationWhenInUseUsageDescription: lokasi kejadian DITUNJUK
		warga lewat isian teks, dan data lokasi pada foto justru dibuang di
		ponsel sebelum foto dikirim.
	-->
	<key>NSCameraUsageDescription</key>
	<string>Untuk memotret keadaan yang Anda adukan, misalnya jalan berlubang atau sampah menumpuk. Data lokasi pada foto dihapus di ponsel Anda sebelum foto dikirim ke kantor desa.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Untuk memilih foto yang sudah Anda potret sebelumnya sebagai lampiran aduan. Data lokasi dan informasi kamera pada foto dihapus di ponsel Anda sebelum foto dikirim.</string>
</dict>
</plist>
